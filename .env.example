# RansomShield Environment Configuration Example
# Copy this file to .env and customize values as needed.

# Application Settings
RANSOMSHIELD_ENV=production
RANSOMSHIELD_API_PORT=8000
RANSOMSHIELD_WEB_PORT=8080

# Security Tokens & Secrets (Change these in production!)
RANSOMSHIELD_API_KEY=changeme-in-production
JWT_SECRET_KEY=ransomshield-deception-key-secret-2026

# Admin Credentials (Set during initial deployment)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@ransomshield.local

# Database Configuration
DATABASE_URL=sqlite:///backend/data/ransomshield.db
